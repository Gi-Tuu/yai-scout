# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，永不提交、永不出现在日志/对话里。
# Tavily：https://app.tavily.com 控制台获取（tvly- 开头）。免费 1,000 credits/月。
TAVILY_API_KEY=

# 模型：DeepSeek / 通义 / 其他 OpenAI 兼容端点
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Bifrost AI Gateway：设置后所有模型请求走 Bifrost OpenAI-compatible endpoint
# 本地启动：scripts/start_bifrost.ps1（或 docker run -p 8080:8080 maximhq/bifrost）
BIFROST_BASE_URL=
BIFROST_API_KEY=
BIFROST_MODEL=

# 可选：Anthropic 备用
ANTHROPIC_API_KEY=

# 运行参数（按需覆盖；字段名即环境变量名的大写形式）
MAX_TAVILY_CREDITS=32
MAX_WALL_CLOCK_SECONDS=360
DEFAULT_AS_OF=2026-11-01


# 可选：Anchor/Discovery 预算与 host 策略
ANCHOR_DISCOVERY_CACHE_ENTRIES=256
ANCHOR_CREATE_ALLOWLIST=

# 公开 Demo：research 开关/预算、anchor 写入权限
RESEARCH_ENABLED=true
DAILY_RESEARCH_LIMIT=5
MAX_ACTIVE_RESEARCH_TASKS=2
PUBLIC_ANCHOR_WRITES=false

# Optional full-page fetch (disabled by default; exact host allowlist)
FULL_PAGE_FETCH_ENABLED=false
FULL_PAGE_ALLOWLIST=

# Benchmark run requires ADMIN_TOKEN unless explicitly disabled
BENCHMARK_RUN_REQUIRES_ADMIN=true
# 0 disables startup pruning; set e.g. 30 for opt-in retention
BENCHMARK_RETENTION_DAYS=0
# Optional one-off XFF diagnostic; empty disables the endpoint
XFF_DEBUG_TOKEN=
